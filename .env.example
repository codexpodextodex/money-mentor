# Copy this file to .env and fill in ONE of the options. Never commit .env.
# Then run:  python scripts/check_model.py

# --- Option A: the Verda key handed out at Junction (Nemotron hosted on Verda) ---
# Ask for it in the Discord #nvidia channel (and DM ElliotNVIDIA).
# Leave LLM_MODEL empty at first: check_model.py lists the model ids the key can see.
# LLM_BASE_URL=https://inference.verda.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_REASONING_EFFORT=

# --- Option B: NVIDIA's hosted API (self-serve, works right away) ------------------
# Get a key at https://build.nvidia.com (open the Nemotron 3.5 Super VL page, "Get API Key").
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_API_KEY=
LLM_REASONING_EFFORT=none

# --- Option C: Nemotron self-hosted on Verda with vLLM (what we run) -----------------
# Deploy the model with deploy/verda.md, then add these three lines. The app asks the Verda
# model first and keeps the LLM_* host above as the fallback. MM_MODEL_HOST=nvidia skips Verda.
# VERDA_INFERENCE_KEY=<Verda console, Credentials, Inference API Keys>
# VERDA_LLM_BASE_URL=https://containers.datacrunch.io/<deployment-name>/v1
# MM_MODEL_HOST=verda
# The same model on a Verda confidential-computing GPU machine (deploy/verda.md). When both are
# set, it answers first, then the serverless container, then the LLM_* host.
# VERDA_CC_LLM_BASE_URL=https://<ip-with-dashes>.sslip.io/v1
# VERDA_CC_LLM_KEY=<the key vLLM was started with on that machine>

# --- Verda cloud API (only scripts/verda.py uses these) ------------------------------
# Verda console: project page, Keys, Cloud API Credentials, Create.
# VERDA_CLIENT_ID=
# VERDA_CLIENT_SECRET=

# --- Optional -----------------------------------------------------------------------
# MM_DATA_DIR=data
# MM_TODAY=2026-09-30
# LLM_TIMEOUT_S=60
